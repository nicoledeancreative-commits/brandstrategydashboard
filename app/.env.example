# Postgres connection string (Prisma).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Vercel Blob read/write token, used for storing uploaded logos/images.
# In production on Vercel: create a Blob store in your project's Storage tab
# and this is injected automatically — no need to set it manually.
# For local development: run `vercel env pull .env.local` after linking the
# project, or copy the token from the Vercel dashboard's Storage tab.
BLOB_READ_WRITE_TOKEN=""
